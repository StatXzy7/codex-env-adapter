<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CodexEnvAdapter</AssemblyName>
    <RootNamespace>CodexEnvAdapter</RootNamespace>
    <Product>Codex环境适配启动器</Product>
    <AssemblyTitle>Codex环境适配启动器</AssemblyTitle>
    <Description>按当前出口节点给 ChatGPT / Codex 注入时区和代理，不修改 Windows 系统时区，也不写系统代理。</Description>
    <Version>1.3.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\third_party\windivert\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third_party\windivert\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="..\..\third_party\windivert\WinDivert.dll" LogicalName="WinDivert.dll" />
    <EmbeddedResource Include="..\..\third_party\windivert\WinDivert64.sys" LogicalName="WinDivert64.sys" />
  </ItemGroup>
  <Target Name="FetchWinDivert" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Get-WinDivert.ps1&quot;" />
  </Target>
</Project>
